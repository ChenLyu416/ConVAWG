# Copy to .env (git-ignored) and export, or set these in your shell.
# No key is ever read from a tracked file.

OPENAI_API_KEY=            # GPT backbones, GPT judge, message labeling, gibberish review
DEEPSEEK_API_KEY=          # DeepSeek generation / judge
GEMINI_API_KEY=            # Gemini generation / judge
HF_TOKEN=                  # optional: gated Hugging Face models

# Local open-weight models are served by a separately launched vLLM server.
VLLM_BASE_URL=http://localhost:8000/v1
